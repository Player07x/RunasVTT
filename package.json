{
  "name": "runas-vtt",
  "version": "0.1.0",
  "private": true,
  "description": "Mesa virtual desktop offline integrada à Runas Suite",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "smoke": "electron-vite build && electron . --smoke",
    "smoke:browser": "electron-vite build && electron . --smoke-browser",
    "seed:sites": "electron-vite build && electron . --seed-sites"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.2",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^1.47.0",
    "pixi.js": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.4.2": true
  }
}
